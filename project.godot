[layer_names]

3d_physics/layer_3="Entities"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality.mobile=3
camera/depth_of_field/depth_of_field_bokeh_quality=2
anti_aliasing/quality/msaa_2d=2
anti_aliasing/quality/msaa_3d=2
scaling_3d/mode=1
scaling_3d/mode.ios=1
scaling_3d/mode.macos=1
textures/decals/filter=0
textures/light_projectors/filter=0
environment/subsurface_scattering/subsurface_scattering_quality=2
anti_aliasing/quality/screen_space_aa=2
occlusion_culling/use_occlusion_culling=true
lights_and_shadows/positional_shadow/atlas_quadrant_0_subdiv=3
lights_and_shadows/positional_shadow/atlas_quadrant_1_subdiv=3
lights_and_shadows/positional_shadow/atlas_quadrant_2_subdiv=4
lights_and_shadows/positional_shadow/atlas_quadrant_3_subdiv=5
environment/screen_space_reflection/roughness_quality=2
